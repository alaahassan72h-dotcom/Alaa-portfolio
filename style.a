/* =========================
   GENERAL SETTINGS
========================= */

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

:root {
    --primary: #38bdf8;
    --primary-dark: #0284c7;
    --background: #0b1120;
    --surface: #111c30;
    --surface-light: #17243b;
    --text: #f1f5f9;
    --muted: #94a3b8;
    --border: rgba(148, 163, 184, 0.15);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.7;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    max-width: 100%;
    display: block;
}

section {
    padding: 100px 8%;
}

/* =========================
   NAVIGATION
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(11, 17, 32, 0.92);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid var(--border);
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    gap: 25px;
}

.logo {
    font-size: 25px;
    font-weight: 800;
    color: var(--text);
    white-space: nowrap;
}

.logo span {
    color: var(--primary);
}

nav a {
    transition: 0.3s ease;
}

nav a:hover {
    color: var(--primary);
}

nav a:not(.logo) {
    margin-left: 18px;
    font-size: 14px;
}

/* =========================
   HERO SECTION
========================= */

.hero {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    position: relative;
    background:
        radial-gradient(
            circle at 85% 20%,
            rgba(56, 189, 248, 0.12),
            transparent 35%
        );
}

.eyebrow {
    color: var(--primary);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(38px, 6vw, 70px);
    line-height: 1.2;
    max-width: 850px;
    margin-bottom: 25px;
    font-weight: 800;
}

.hero h1 span {
    color: var(--primary);
}

.intro {
    max-width: 650px;
    color: var(--muted);
    font-size: 17px;
    margin-bottom: 35px;
}

/* =========================
   BUTTONS
========================= */

.btn {
    display: inline-block;
    padding: 13px 28px;
    background: var(--primary);
    color: #07111f;
    border: 1px solid var(--primary);
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    transition: 0.3s ease;
    margin: 5px 10px 5px 0;
}

.btn:hover {
    background: var(--primary-dark);
    border-color: var(--primary-dark);
    color: white;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(56, 189, 248, 0.15);
}

.btn.outline {
    background: transparent;
    color: var(--primary);
}

.btn.outline:hover {
    background: var(--primary);
    color: #07111f;
}

/* =========================
   SECTION HEADINGS
========================= */

section h2 {
    font-size: clamp(28px, 4vw, 42px);
    margin-bottom: 35px;
    font-weight: 700;
}

section h2::after {
    content: "";
    display: block;
    width: 60px;
    height: 4px;
    background: var(--primary);
    border-radius: 5px;
    margin-top: 12px;
}

/* =========================
   ABOUT SECTION
========================= */

#about {
    background: #0e1729;
}

#about .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: center;
}

#about p {
    color: var(--muted);
    margin-bottom: 20px;
}

#about .info {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 15px;
}

#about .info p {
    margin: 0;
}

#about b {
    color: var(--primary);
}

/* =========================
   SKILLS SECTION
========================= */

#skills {
    background: var(--background);
}

#skills .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
}

#skills .grid > div {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px;
    transition: 0.3s ease;
}

#skills .grid > div:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
}

#skills .grid b {
    color: var(--primary);
    font-size: 13px;
}

#skills .grid h3 {
    margin: 10px 0;
    font-size: 21px;
}

#skills .grid p {
    color: var(--muted);
    font-size: 14px;
}

/* =========================
   PROJECTS SECTION
========================= */

#projects {
    background: #0e1729;
}

#projects .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px;
}

#projects article {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: 0.3s ease;
}

#projects article:hover {
    transform: translateY(-6px);
    border-color: var(--primary);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
}

#projects .visual {
    padding: 25px 25px 10px;
}

#projects .visual span {
    display: inline-block;
    background: rgba(56, 189, 248, 0.12);
    color: var(--primary);
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}

#projects .project-image {
    padding: 15px 25px;
}

#projects .project-image img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: top;
    border-radius: 8px;
    border: 1px solid var(--border);
}

#projects .body {
    padding: 20px 25px 28px;
}

#projects .body h3 {
    font-size: 22px;
    margin-bottom: 12px;
}

#projects .body p {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 20px;
}

/* =========================
   CERTIFICATES SECTION
========================= */

#certificates {
    background: var(--background);
}

#certificates .cert {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 20px;
    transition: 0.3s ease;
}

#certificates .cert:hover {
    border-color: var(--primary);
    transform: translateY(-4px);
}

#certificates .cert h3 {
    color: var(--text);
    margin-bottom: 8px;
}

#certificates .cert p {
    color: var(--muted);
}

/* =========================
   CONTACT SECTION
========================= */

#contact {
    background: #0e1729;
    text-align: center;
}

#contact h2::after {
    margin-left: auto;
    margin-right: auto;
}

#contact p {
    color: var(--muted);
    margin-bottom: 25px;
}

/* =========================
   FOOTER
========================= */

footer {
    text-align: center;
    padding: 25px 8%;
    background: var(--background);
    color: var(--muted);
    font-size: 13px;
    border-top: 1px solid var(--border);
}

/* =========================
   RESPONSIVE DESIGN
========================= */

@media (max-width: 900px) {

    section {
        padding: 75px 6%;
    }

    nav {
        padding: 18px 6%;
        flex-wrap: wrap;
    }

    nav a:not(.logo) {
        margin-left: 10px;
        font-size: 12px;
    }

    #about .two {
        grid-template-columns: 1fr;
    }

    #projects .projects {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 600px) {

    section {
        padding: 60px 5%;
    }

    nav {
        justify-content: center;
    }

    nav .logo {
        width: 100%;
        text-align: center;
    }

    nav a:not(.logo) {
        margin: 5px;
        font-size: 12px;
    }

    .hero {
        min-height: 75vh;
    }

    .hero h1 {
        font-size: 38px;
    }

    .intro {
        font-size: 15px;
    }

    #skills .grid {
        grid-template-columns: 1fr;
    }

    #projects .project-image img {
        height: 180px;
    }

}
.project-filters {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 35px 0;
}

.filter-btn {
    padding: 10px 22px;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 30px;
    background: transparent;
    color: #aaa;
    font-size: 14px;
    cursor: pointer;
    transition: 0.3s ease;
}

.filter-btn:hover {
    color: white;
    border-color: #8b5cf6;
    transform: translateY(-2px);
}

.filter-btn.active {
    background: linear-gradient(135deg, #8b5cf6, #a855f7);
    color: white;
    border-color: transparent;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.25);
}
.project-card {
    width: 100%;
    max-width: 1000px !important;
}

.project-image {
    width: 100% !important;
    height: 420px !important;
    overflow: hidden;
}

.project-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
}
.contact-item {
    width: 100% !important;
    height: 90px !important;
    min-height: 90px !important;
    padding: 20px !important;
    box-sizing: border-box !important;
}
@media (max-width: 768px) {

    /* Navigation */
    nav ul {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }

    /* Sections */
    section {
        padding: 60px 20px;
    }

    /* Projects */
    .projects-grid {
        grid-template-columns: 1fr;
    }

    .project-card {
        width: 100%;
        max-width: 100%;
    }

    .project-image {
        height: 280px !important;
    }

    /* Contact */
    .contact-links {
        grid-template-columns: 1fr;
    }

    .contact-item {
        width: 100% !important;
    }

    /* Skills */
    .skills-grid {
        grid-template-columns: 1fr;
    }

    /* Footer */
    .footer-content {
        flex-direction: column;
        text-align: center;
    }

    .footer-links {
        justify-content: center;
    }
    
    .about-container {
    grid-template-columns: 1fr;
    gap: 35px;
    }
    .skills-grid {
    grid-template-columns: 1fr;
}
}
html {
    scroll-behavior: smooth;
}

nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(12px);
    background: rgba(10, 10, 20, 0.75);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

nav a {
    text-decoration: none;
    transition: all 0.3s ease;
}

nav a:hover {
    color: #a855f7;
}

nav a.active {
    color: #a855f7;
}
nav ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
}
.project-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
}
.project-image img {
    transition: transform 0.4s ease;
}

.project-card:hover .project-image img {
    transform: scale(1.03);
}
.hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    padding: 100px 20px;
}

.hero-greeting {
    font-size: 18px;
    color: #a855f7;
    margin-bottom: 10px;
}

.hero-content h1 {
    font-size: clamp(45px, 7vw, 80px);
    margin: 0;
    font-weight: 700;
}

.hero-content h2 {
    font-size: clamp(25px, 4vw, 40px);
    margin: 10px 0 20px;
    color: #a855f7;
}

.hero-description {
    max-width: 650px;
    margin: 0 auto 35px;
    color: #aaa;
    line-height: 1.8;
    font-size: 17px;
}

.hero-buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

.hero-btn {
    padding: 13px 25px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    transition: 0.3s ease;
}

.primary-btn {
    background: linear-gradient(135deg, #8b5cf6, #a855f7);
    color: white;
}

.secondary-btn {
    border: 1px solid rgba(255,255,255,0.2);
    color: white;
    background: transparent;
}

.hero-btn:hover {
    transform: translateY(-3px);
}

.primary-btn:hover {
    box-shadow: 0 10px 30px rgba(139, 92, 246, 0.3);
}

.secondary-btn:hover {
    border-color: #a855f7;
    color: #a855f7;
}
.about-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 70px;
    align-items: center;
}

.section-label {
    color: #a855f7;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.about-text h2 {
    font-size: clamp(30px, 4vw, 45px);
    margin-bottom: 25px;
}

.about-text p:not(.section-label) {
    color: #aaa;
    line-height: 1.8;
    margin-bottom: 18px;
}

.about-highlight {
    padding: 30px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    background: rgba(255,255,255,0.03);
    backdrop-filter: blur(10px);
}

.highlight-item {
    display: flex;
    gap: 18px;
    padding: 20px 0;
}

.highlight-item:not(:last-child) {
    border-bottom: 1px solid rgba(255,255,255,0.08);
}

.highlight-item > span {
    color: #a855f7;
    font-weight: 700;
}

.highlight-item h3 {
    margin: 0 0 7px;
}

.highlight-item p {
    margin: 0;
    color: #999;
    line-height: 1.6;
}
.skills-container {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
}

.skills-container h2 {
    font-size: clamp(30px, 4vw, 45px);
    margin: 10px 0 15px;
}

.skills-intro {
    max-width: 600px;
    margin: 0 auto 45px;
    color: #999;
    line-height: 1.7;
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    text-align: left;
}

.skill-card {
    position: relative;
    padding: 30px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
    transition: 0.3s ease;
    overflow: hidden;
}

.skill-card:hover {
    transform: translateY(-7px);
    border-color: rgba(168,85,247,0.5);
    box-shadow: 0 15px 35px rgba(0,0,0,0.2);
}

.skill-number {
    color: #a855f7;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 25px;
}

.skill-card h3 {
    margin-bottom: 12px;
    font-size: 21px;
}

.skill-card p {
    color: #999;
    line-height: 1.7;
    margin: 0;
}
/* Fix section layout */
section {
    width: 100%;
    display: block;
    clear: both;
}

.skills-section,
.projects-section,
.learning-section,
.contact-section {
    width: 100%;
    display: block;
    clear: both;
}
.projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px;
    text-align: left;
}

.project-card {
    width: 100%;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
    transition: 0.3s ease;
}

.project-card:hover {
    transform: translateY(-7px);
    border-color: rgba(168,85,247,0.5);
    box-shadow: 0 15px 35px rgba(0,0,0,0.2);
}

.project-image {
    width: 100%;
    height: 280px;
    overflow: hidden;
}

.project-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    display: block;
}

.project-content {
    padding: 25px;
}

.project-category {
    color: #a855f7;
    font-size: 13px;
    font-weight: 700;
}

.project-content h3 {
    margin: 10px 0 12px;
    font-size: 21px;
}

.project-content p {
    color: #999;
    line-height: 1.7;
    margin-bottom: 20px;
}

.project-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
}

.project-tools span {
    padding: 6px 12px;
    border-radius: 20px;
    background: rgba(168,85,247,0.1);
    color: #c084fc;
    font-size: 12px;
}

.project-btn {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 25px;
    background: linear-gradient(135deg, #8b5cf6, #a855f7);
    color: white;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: 0.3s ease;
}
@media (max-width: 768px) {

    .projects-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .project-card {
        width: 100%;
    }

    .project-image {
        height: 250px !important;
    }

    .project-content {
        padding: 20px;
    }

    .project-content h3 {
        font-size: 19px;
    }

    .project-filters {
        gap: 8px;
    }

    .filter-btn {
        padding: 9px 16px;
        font-size: 13px;
    }
}
.project-card {
    animation: fadeUp 0.6s ease both;
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}
.certificates-section {
    padding: 100px 20px;
}

.certificates-container {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
}

.certificates-container h2 {
    font-size: clamp(30px, 4vw, 45px);
    margin: 10px 0 15px;
}

.certificates-intro {
    max-width: 650px;
    margin: 0 auto 45px;
    color: #999;
    line-height: 1.7;
}

.certificates-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    text-align: left;
}

.certificate-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 25px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
    transition: 0.3s ease;
}

.certificate-card:hover {
    transform: translateY(-5px);
    border-color: rgba(168,85,247,0.5);
    box-shadow: 0 15px 35px rgba(0,0,0,0.2);
}

.certificate-logo {
    min-width: 65px;
    height: 65px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: linear-gradient(135deg, #8b5cf6, #a855f7);
    color: white;
    font-weight: 700;
    font-size: 14px;
}

.certificate-content span {
    color: #a855f7;
    font-size: 12px;
    font-weight: 700;
}

.certificate-content h3 {
    margin: 7px 0 8px;
    font-size: 18px;
}

.certificate-content p {
    margin: 0;
    color: #999;
    line-height: 1.6;
    font-size: 14px;
}
@media (max-width: 768px) {

    .certificates-grid {
        grid-template-columns: 1fr;
    }

    .certificate-card {
        padding: 20px;
    }

    .certificate-logo {
        min-width: 55px;
        height: 55px;
    }
}
.certificate-image {
    width: 180px;
    height: 120px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 12px;
    background: rgba(255,255,255,0.05);
}
.contact-section {
    padding: 100px 20px;
}

.contact-container {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
}

.contact-container h2 {
    font-size: clamp(30px, 4vw, 45px);
    margin: 10px 0 15px;
}

.contact-intro {
    max-width: 600px;
    margin: 0 auto 45px;
    color: #999;
    line-height: 1.7;
}

.contact-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.contact-item {
    min-height: 90px;
    padding: 20px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 15px;
    text-align: left;
    text-decoration: none;
    color: white;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    background: rgba(255,255,255,0.03);
    transition: 0.3s ease;
}

.contact-item:hover {
    transform: translateY(-5px);
    border-color: rgba(168,85,247,0.5);
    box-shadow: 0 12px 30px rgba(0,0,0,0.2);
}

.contact-icon {
    width: 45px;
    height: 45px;
    min-width: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(168,85,247,0.12);
    color: #c084fc;
    font-weight: 700;
}

.contact-item h3 {
    margin: 0 0 5px;
    font-size: 16px;
}

.contact-item p {
    margin: 0;
    color: #999;
    font-size: 13px;
}
@media (max-width: 768px) {

    .contact-links {
        grid-template-columns: 1fr;
    }

    .contact-item {
        width: 100%;
    }
}
.about-section {
    padding: 100px 20px;
}

.about-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 70px;
    align-items: center;
}

.about-photo {
    position: relative;
    padding: 12px;
    border-radius: 25px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
}

.about-photo img {
    width: 100%;
    height: 450px;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 18px;
}

.about-photo-info {
    position: absolute;
    bottom: 25px;
    left: 25px;
    right: 25px;
    padding: 15px 18px;
    border-radius: 14px;
    background: rgba(10,10,20,0.8);
    backdrop-filter: blur(10px);
}

.about-photo-info h3 {
    margin: 0 0 4px;
}

.about-photo-info p {
    margin: 0;
    color: #a855f7;
    font-size: 14px;
}

.about-text h2 {
    font-size: clamp(30px, 4vw, 45px);
    margin: 10px 0 25px;
}

.about-text > p:not(.section-label) {
    color: #aaa;
    line-height: 1.8;
    margin-bottom: 18px;
}

.about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
}

.about-tags span {
    padding: 8px 14px;
    border-radius: 20px;
    background: rgba(168,85,247,0.1);
    color: #c084fc;
    font-size: 13px;
}
@media (max-width: 768px) {

    .about-container {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .about-photo {
        max-width: 380px;
        margin: 0 auto;
    }

    .about-photo img {
        height: 400px;
    }
}